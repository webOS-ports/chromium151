import("//build/config/features.gni")

schema_sources_ = [
  # NOTE: no scripting.idl here. M151 moved the scripting API into
  # //extensions/common/api, which app_shell already links; compiling a second
  # copy into the same extensions::api::scripting namespace gave duplicate
  # symbols at link time. Upstream also ships the browser-side implementation
  # and registration for all seven scripting functions, so nothing is lost.
  "tabs.json",
  "windows.json",
]

uncompiled_sources_ = [
  "action.json",
  # app.json is a stub with no types or functions, present only so `isChrome`
  # checks pass. M151's bundle generator emits an API registration include for
  # every compiled schema, which would reference a neva/extensions/browser/api/
  # app/app_api.h that has never existed. Uncompiled schemas still reach JS via
  # generated_api_json_strings, which is all this stub needs.
  "app.json",
  "browser_action.json",
  "page_action.json",
]

neva_extensions_api_schema_sources = get_path_info(schema_sources_, "abspath")

neva_extensions_manifest_only_schema_sources = []

neva_extensions_api_uncompiled_sources =
    get_path_info(uncompiled_sources_, "abspath")

neva_extensions_api_root_namespace = "extensions::api::%(namespace)s"

neva_extensions_api_schema_include_rules =
    "extensions/common/api:extensions::api::%(namespace)s"
