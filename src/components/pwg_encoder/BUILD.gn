import("//printing/buildflags/buildflags.gni")
import("//neva/neva.gni")

# NEVA: neva sets enable_print_preview=false but never builds any //chrome
# target, while M151 references print_preview unconditionally from many
# places. Relax the assert so the GN graph stays parseable.
assert(enable_print_preview || use_neva_appruntime)

static_library("pwg_encoder") {
  sources = [
    "bitmap_image.cc",
    "bitmap_image.h",
    "pwg_encoder.cc",
    "pwg_encoder.h",
  ]

  deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "pwg_encoder_unittest.cc" ]

  deps = [
    ":pwg_encoder",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
