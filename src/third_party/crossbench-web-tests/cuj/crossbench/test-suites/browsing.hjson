{
  groups: [
    {
      filter_regex: browsing-multitab
      min_successes: 1
    }
    {
      filter_regex: browsing-multiwindow
      min_successes: 1
    }
    {
      filter_regex: browsing
      variants_filter_regex: ^(casual|heavy)$
      min_successes: 1
    }
    {
      filter_regex: classroom
      min_successes: 10
    }
    {
      filter_regex: cpu-stress
      min_successes: 5
    }
    {
      filter_regex: docs
      min_successes: 10
    }
    {
      filter_regex: gmail
      min_successes: 10
    }
    {
      filter_regex: local-conference
      min_successes: 10
    }
    {
      filter_regex: meet-note
      min_successes: 10
    }
    {
      filter_regex: meet
      min_successes: 10
    }
    {
      filter_regex: open-close
      min_successes: 10
    }
    {
      filter_regex: page-click
      min_successes: 10
    }
    {
      filter_regex: page-scroll
      min_successes: 10
    }
    {
      filter_regex: sheets
      min_successes: 10
    }
    {
      filter_regex: simultaneous-load
      min_successes: 10
    }
    {
      filter_regex: slides
      min_successes: 10
    }
    {
      filter_regex: tab-stress
      variants_filter_regex: blank
      min_successes: 10
    }
    {
      filter_regex: tab-stress
      variants_filter_regex: multi-process
      min_successes: 10
    }
    {
      filter_regex: tiktok
      min_successes: 10
    }
    {
      filter_regex: video-playback-online-browser
      min_successes: 10
    }
    {
      filter_regex: videocall
      variants_filter_regex: ^1m.*
      min_successes: 10
    }
    {
      filter_regex: youtube-watch-browse
      min_successes: 10
    }
    {
      filter_regex: youtube
      min_successes: 10
    }
    {
      filter_regex: click-input-latency
      min_successes: 10
    }
    {
      filter_regex: docs-tab-switches
      min_successes: 10
    }
    {
      filter_regex: typing-input-latency
      min_successes: 10
    }
    {
      filter_regex: heavy-meet-note
      min_successes: 10
    }
  ]
}
