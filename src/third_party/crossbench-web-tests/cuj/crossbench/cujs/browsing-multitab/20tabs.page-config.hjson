{
  args: {
    // PAGE args
    BASE_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest
    VERSION: 2023-08-09
    URL_PREFIX: $[BASE_URL]/$[VERSION]/
    PER_PAGE_DURATION: 180
    PAGE_1: $[URL_PREFIX]amazon_product.html
    PAGE_2: $[URL_PREFIX]amazon_search.html
    PAGE_3: $[URL_PREFIX]apple_small.html
    PAGE_4: $[URL_PREFIX]ebay.html
    PAGE_5: $[URL_PREFIX]google.html
    PAGE_6: $[URL_PREFIX]imdb.html
    PAGE_7: $[URL_PREFIX]weather.html
    PAGE_8: $[URL_PREFIX]office.html
    PAGE_9: $[URL_PREFIX]stackoverflow.html
    PAGE_10: $[URL_PREFIX]wikipedia.html
    PAGE_11: $[URL_PREFIX]amazon_search.html
    PAGE_12: $[URL_PREFIX]apple_small.html
    PAGE_13: $[URL_PREFIX]bbc.html
    PAGE_14: $[URL_PREFIX]google.html
    PAGE_15: $[URL_PREFIX]live.html
    PAGE_16: $[URL_PREFIX]samsung.html
    PAGE_17: $[URL_PREFIX]wattpad.html
    PAGE_18: $[URL_PREFIX]wikipedia.html
    PAGE_19: $[URL_PREFIX]yahoo.html
    PAGE_20: $[URL_PREFIX]yelp.html
  }
  template: {
    pages: {
      page-scroll-1: {
        template: ./action-blocks/switch-tab-and-page-scroll.hjson
        args: {
          PAGE_URL: $[PAGE_1]
          TARGET: _self
          TAB_INDEX: 0
        }
        unbound_args: [
          PAGE_1
          PER_PAGE_DURATION
        ]
      }
      page-scroll-2: {
        template: ./action-blocks/switch-tab-and-page-scroll.hjson
        args: {
          PAGE_URL: $[PAGE_2]
          TARGET: _new_tab
          TAB_INDEX: 1
        }
        unbound_args: [
          PAGE_2
          PER_PAGE_DURATION
        ]
      }
      page-scroll-3: {
        template: ./action-blocks/switch-tab-and-page-scroll.hjson
        args: {
          PAGE_URL: $[PAGE_3]
          TARGET: _new_tab
          TAB_INDEX: 2
        }
        unbound_args: [
          PAGE_3
          PER_PAGE_DURATION
        ]
      }
      page-scroll-4: {
        template: ./action-blocks/switch-tab-and-page-scroll.hjson
        args: {
          PAGE_URL: $[PAGE_4]
          TARGET: _new_tab
          TAB_INDEX: 3
        }
        unbound_args: [
          PAGE_4
          PER_PAGE_DURATION
        ]
      }
