{
  template: ./action-blocks/browsing-simple.hjson
  args: {
    REDIRECT_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/v2_config/redirect.html
    VERSION: 2023-08-09
    URL_PREFIX: $[REDIRECT_URL]?ver=$[VERSION]&dest=
    PAGE_1: $[URL_PREFIX]gpu_mem_pressure&initialPoolSize=280&internalWidth=1440&viewportHeight=500&poolIncrement=20&freezeAfterFrame=300&instancename=back
    PAGE_2: $[URL_PREFIX]gpu_mem_pressure&initialPoolSize=30&internalWidth=1440&viewportHeight=500&poolIncrement=2&freezeAfterFrame=2000
  }
}
