{
  template: ./action-blocks/browsing-multiwindow.hjson
  args: {
    BASE_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest
    VERSION: 2023-08-09
    URL_PREFIX: $[BASE_URL]/$[VERSION]/
    PAGE_1: $[URL_PREFIX]amazon_search.html
    PAGE_2: $[URL_PREFIX]apple_small.html
    PAGE_3: $[URL_PREFIX]bbc.html
    PAGE_4: $[URL_PREFIX]google.html
    PAGE_5: $[URL_PREFIX]live.html
    PAGE_6: $[URL_PREFIX]samsung.html
    PAGE_7: $[URL_PREFIX]wattpad.html
    PAGE_8: $[URL_PREFIX]wikipedia.html
    PAGE_9: $[URL_PREFIX]yahoo.html
    PAGE_10: $[URL_PREFIX]yelp.html
  }
}
