import("//neva/neva.gni")

declare_args() {
  # This enables building LiteRT with XNNPACK.
  # NEVA: keep in step with build_tflite_with_xnnpack in
  # //third_party/tflite/features.gni - XNNPACK is not built for webOS, and
  # LiteRT's CPU accelerator would otherwise reference TfLiteXNNPackDelegate*
  # symbols that tflite never defines.
  build_litert_with_xnnpack = current_cpu != "arm" && !is_fuchsia && !is_webos
}
