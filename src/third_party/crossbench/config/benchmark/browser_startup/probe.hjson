{
  "probes": {
    "perfetto": {
      "trace_browser_startup": true
      "textproto":
        '''
        buffers {
          size_kb: 102400
          fill_policy: RING_BUFFER
        }
        data_sources {
          config {
            name: "track_event"
            track_event_config {
              disabled_categories: "*"
              enabled_categories: "benchmark"
              enabled_categories: "toplevel"
              enabled_categories: "startup"
              enabled_categories: "blink.user_timing"
              enabled_categories: "navigation"
              enabled_categories: "loading"
              timestamp_unit_multiplier: 1000
              enable_thread_time_sampling: true
            }
          }
        }
        data_sources {
          config {
            name: "org.chromium.histogram_sample"
            chromium_histogram_samples {
              histograms {
                histogram_name: "Startup.FirstWebContents.NonEmptyPaint3"
              }
            }
          }
        }
        data_sources {
          config {
            name: "org.chromium.trace_metadata2"
          }
        }
        '''
    }
    "trace_processor": {
      "queries": [
        {
          "name": "browser_window_first_paint"
          "sql":
            '''
            SELECT
              (paint.ts - (SELECT min(ts) FROM slice)) / 1e6 AS duration_ms
            FROM slice AS paint
            WHERE paint.name LIKE '%Startup.BrowserWindow.FirstPaint'
            LIMIT 1
            '''
        }
      ]
    }
  }
}
