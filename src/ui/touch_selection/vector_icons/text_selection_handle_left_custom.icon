// webOS drew the ends of a selection as small shields that point at the text -
// topmarker.png and bottommarker.png. Measured off a legacy screenshot: 15 by
// 13 pixels, a point on top whose sides reach full width a little over half
// way down, and a body below it with its bottom corners rounded off. Those
// proportions on Chromium's 32 unit canvas.
//
// Two paths, and NEW_PATH between them for a reason: a path here is filled
// even-odd by default, so an inset second shape inside the first one is a hole
// rather than a body, and the handle comes out as an outline you cannot see.
// NEW_PATH starts a path of its own, filled nonzero.
//
// Pointing up in all three, because these handles are drawn below the line
// they belong to. Legacy put the one at the start of a selection above the
// line and pointed it down, which is a matter of where the handle is placed
// rather than how it is drawn - see TouchHandle's layout.

CANVAS_DIMENSIONS, 32,

// The edge, at full size, in the dark olive-grey legacy outlined these with -
// sampled off a legacy screenshot at (126, 120, 91).
PATH_COLOR_ARGB, 0xFF, 0x7E, 0x78, 0x5B,
MOVE_TO, 16, 0,
LINE_TO, 32, 14.9,
V_LINE_TO, 22.7,
ARC_TO, 5, 5, 0, 0, 1, 27, 27.7,
H_LINE_TO, 5,
ARC_TO, 5, 5, 0, 0, 1, 0, 22.7,
V_LINE_TO, 14.9,
CLOSE,

// The body, as its own path so that it fills, inset so the edge shows round it.
NEW_PATH,
PATH_COLOR_ARGB, 0xFF, 0xD9, 0xD9, 0xD8,
MOVE_TO, 16, 2.4,
LINE_TO, 30.4, 15.6,
V_LINE_TO, 22.1,
ARC_TO, 4, 4, 0, 0, 1, 26.4, 26.1,
H_LINE_TO, 5.6,
ARC_TO, 4, 4, 0, 0, 1, 1.6, 22.1,
V_LINE_TO, 15.6,
CLOSE
